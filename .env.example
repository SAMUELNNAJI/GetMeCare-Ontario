# Security
SECRET_KEY=your-secret-key-here
DEBUG=False


# Database (Render provides this automatically)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Groq API
GROQ_API_KEY=your-groq-api-key-here

# Fincra Payment Gateway
FINCRA_SECRET_KEY=your-fincra-secret-key
FINCRA_PUBLIC_KEY=your-fincra-public-key
FINCRA_WEBHOOK_KEY=your-fincra-webhook-encryption-key
FINCRA_BASE_URL=https://sandboxapi.fincra.com
FINCRA_BUSINESS_ID=your-fincra-business-id
FINCRA_CURRENCY=NGN
FINCRA_USD_TO_NGN_RATE=1580

# ImageKit (media storage — required for Render/production)
# Sign up free at https://imagekit.io
IMAGEKIT_PRIVATE_KEY=your-private-key
IMAGEKIT_PUBLIC_KEY=your-public-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_FOLDER=getmecare
# Set to True to test ImageKit uploads while DEBUG=True (default is local media/)
USE_IMAGEKIT=False
