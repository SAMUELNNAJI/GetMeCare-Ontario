# Security
SECRET_KEY=your-secret-key-here
DEBUG=False


# Database (Render provides this automatically)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Groq API
GROQ_API_KEY=your-groq-api-key-here

# ── Email Configuration (ZeptoMail SMTP) ────────────────────────
# Outbound emails (including user notifications and admin alerts) are sent via ZeptoMail:
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=your-zeptomail-api-password-here
DEFAULT_FROM_EMAIL=GetMeCare Ontario <noreply@getmecare-ontario.com>

# Destination where you receive admin alerts (new requests, matching updates, disputes):
ADMIN_EMAIL=getmecareontario@gmail.com
CONTACT_EMAIL=getmecareontario@gmail.com

# Contact form only — Direct Gmail SMTP (does NOT consume ZeptoMail credits):
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=getmecareontario@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password


# Notification channel for operational alerts: 'email' (recommended), 'both', or 'whatsapp'
ADMIN_NOTIFICATION_CHANNEL=email

# WhatsApp Business Platform (Meta)
# Admin WhatsApp number (the number that receives alerts)
ADMIN_WHATSAPP_NUMBER=+12494812647

# Verify token Meta sends in the webhook registration GET.
# Set the same string in the Meta Developer Dashboard "Callback URL" verification.
ADMIN_WHATSAPP_WEBHOOK_VERIFY_TOKEN=my-secret-verify-token-12345

# Access token for the Meta Graph API (Long-Lived Page Access Token).
# Generate from: Facebook App → WhatsApp → API Setup → Generate Token.
ADMIN_WHATSAPP_ACCESS_TOKEN=

# WhatsApp Business Platform Number ID (the "c" in the Graph API).
# Get it from: Graph API Explorer → waba_id → Your Business Account → phone_number_id.
ADMIN_WHATSAPP_NUMBER_ID=

# The URL Meta uses when it POSTs status updates (sent/delivered/read) back to
# your server.  Example: https://www.getmecare-ontario.com/webhooks/whatsapp/
# This is also the "CALLBACK URL" you register in the Meta Dashboard.
ADMIN_WHATSAPP_WEBHOOK_URL=

# OPTIONAL: signing secret for the callback (whsec_...).  Paste the exact value
# Meta gives you in the Dashboard Webhooks → "Signing Secret".  Leave empty to
# skip signature verification.
ADMIN_WHATSAPP_WEBHOOK_SECRET=

# Fallback: direct Meta Graph API POST (legacy pattern, not needed when the
# webhook URL above is configured).
# ADMIN_WHATSAPP_API_URL=

# Fincra Payment Gateway
FINCRA_SECRET_KEY=your-fincra-secret-key
FINCRA_PUBLIC_KEY=your-fincra-public-key
FINCRA_WEBHOOK_KEY=your-fincra-webhook-encryption-key
FINCRA_BASE_URL=https://sandboxapi.fincra.com
FINCRA_BUSINESS_ID=your-fincra-business-id
FINCRA_CURRENCY=NGN
FINCRA_USD_TO_NGN_RATE=1580

# ImageKit (media storage — required for Render/production)
# Sign up free at https://imagekit.io
IMAGEKIT_PRIVATE_KEY=your-private-key
IMAGEKIT_PUBLIC_KEY=your-public-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_FOLDER=getmecare
# Set to True to test ImageKit uploads while DEBUG=True (default is local media/)
USE_IMAGEKIT=False
